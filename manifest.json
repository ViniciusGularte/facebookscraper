{
  "manifest_version": 3,
  "name": "GrabClientsNow",
  "version": "1.0.2",
  "description": "Monitor Facebook groups and capture leads in real time.",
  "permissions": ["storage", "tabs", "scripting", "alarms", "notifications"],
  "host_permissions": [
    "https://www.facebook.com/*",
    "https://web.facebook.com/*",
    "https://*.supabase.co/*"
  ],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "icons": {
    "16": "assets/icon-48.png",
    "32": "assets/icon-48.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.facebook.com/*", "https://web.facebook.com/*"],
      "js": ["content_script.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "GrabClientsNow",
    "default_icon": {
      "16": "assets/icon-48.png",
      "32": "assets/icon-48.png",
      "48": "assets/icon-48.png",
      "128": "assets/icon-128.png"
    }
  }
}
